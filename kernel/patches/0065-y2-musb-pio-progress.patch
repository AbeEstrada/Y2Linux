+/* Start a freshly queued request on an idle endpoint. Unlike a restart after
+ * dequeue, an OUT FIFO may legitimately hold a packet the host was already
+ * ACKed for: flushing it silently dropped that packet (and re-writing the
+ * sampled RXCSR could re-assert RXPKTRDY and leave the endpoint NAKing
+ * forever). Service the FIFO instead. */
+static void musb_ep_start(struct musb *musb, struct musb_request *req)
+{
+	trace_musb_req_start(req);
+	musb_ep_select(musb->mregs, req->epnum);
+	Y2_RXEV(Y2_RX_QUEUE, req->epnum,
+		req->tx ? 0 : musb_readw(req->ep->hw_ep->regs, MUSB_RXCSR),
+		req->request.length);
+	if (req->tx)
+		txstate(musb, req);
+	else
+		rxstate(musb, req, true);
+}
