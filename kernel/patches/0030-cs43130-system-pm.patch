+static int cs43130_system_suspend(struct device *dev)
+{
+	int ret;
+
+	cs43130_pm_note("cs_sleep_begin", 0);
+	ret = pm_runtime_force_suspend(dev);
+	cs43130_pm_note("cs_sleep_done", ret);
+	return ret;
+}
+
+static int cs43130_system_resume(struct device *dev)
+{
+	int ret;
+
+	cs43130_pm_note("cs_force_begin", 0);
+	ret = pm_runtime_force_resume(dev);
+	cs43130_pm_note("cs_force_done", ret);
@@ -2730,0 +2797 @@
+	SYSTEM_SLEEP_PM_OPS(cs43130_system_suspend, cs43130_system_resume)
