+	if (ret) {
+		/* Bulk disable restores the prior rail references on failure. A
+		 * reset or partial rail cycle may have erased codec state; the XTAL
+		 * interrupt was masked too. Replay without enabling rails twice. */
+		cs43130_pm_note("cs_disable_fail", ret);
+		restore = cs43130_restore_cache(cs43130);
+		if (restore) {
+			dev_err(dev, "Failed to restore after supply refusal: %d\n", restore);
+			return restore;
+		}
+		dev_err(dev, "Failed to disable supplies: %d\n", ret);
+	}
+	return ret;
