+	&dev_attr_hpload_dc.attr,
+	&dev_attr_hpload_debug.attr,
+	NULL,
+};
+static const struct attribute_group y2_hp_group = {
+	.name = "y2_hp",
+	.attrs = y2_hp_attrs,
+};
