-		regmap_update_bits(cs43130->regmap, CS43130_INT_MASK_1,
+	int ret, restore;
+
+	if (cs43130->xtal_ibias != CS43130_XTAL_UNUSED) {
+		ret = regmap_update_bits(cs43130->regmap, CS43130_INT_MASK_1,
 				   CS43130_XTAL_ERR_INT,
 				   1 << CS43130_XTAL_ERR_INT_SHIFT);
+		if (ret)
+			return ret;
+	}
 
 	regcache_cache_only(cs43130->regmap, true);
 	regcache_mark_dirty(cs43130->regmap);
-
 	gpiod_set_value_cansleep(cs43130->reset_gpio, 0);
 
-	regulator_bulk_disable(CS43130_NUM_SUPPLIES, cs43130->supplies);
-
-	return 0;
+	ret = regulator_bulk_disable(CS43130_NUM_SUPPLIES, cs43130->supplies);
+	if (ret) {
+		/* Bulk disable restores the prior rail references on failure. A
+		 * reset or partial rail cycle may have erased codec state; the XTAL
+		 * interrupt was masked too. Replay without enabling rails twice. */
+		cs43130_pm_note("cs_disable_fail", ret);
+		restore = cs43130_restore_cache(cs43130);
+		if (restore) {
+			dev_err(dev, "Failed to restore after supply refusal: %d\n", restore);
+			return restore;
+		}
+		dev_err(dev, "Failed to disable supplies: %d\n", ret);
+	}
+	return ret;
 }
 
