+/* Retained Y2 callback ring phase from the core's own callback labels. */
+static unsigned y2_pm_callback_phase(const char *info, pm_message_t state)
+{
+	bool resume = state.event & (PM_EVENT_RESUME | PM_EVENT_THAW | PM_EVENT_RESTORE | PM_EVENT_RECOVER);
+	if (info && !strncmp(info, "noirq", 5))
+		return resume ? Y2_PM_PHASE_RESUME_NOIRQ : Y2_PM_PHASE_NOIRQ;
+	if (info && !strncmp(info, "late", 4))
+		return Y2_PM_PHASE_LATE;
+	if (info && !strncmp(info, "early", 5))
+		return Y2_PM_PHASE_EARLY;
+	return resume ? Y2_PM_PHASE_RESUME : Y2_PM_PHASE_SUSPEND;
+}
