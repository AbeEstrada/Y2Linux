+	y2_pm_device(dev, y2_pm_callback_phase(info, state), 0, false);
 	error = cb(dev);
+	y2_pm_device(dev, y2_pm_callback_phase(info, state), error, true);
 	trace_device_pm_callback_end(dev, error);
 	suspend_report_result(dev, cb, error);
 
