--- a/fs/fat/dir.c
+++ b/fs/fat/dir.c
@@ -18,6 +18,7 @@
 #include <linux/compat.h>
 #include <linux/uaccess.h>
 #include <linux/iversion.h>
+#include <linux/blkdev.h>
 #include "fat.h"
 
 /*
@@ -63,8 +64,15 @@
 
 	bh = sb_find_get_block(sb, phys);
 	if (bh == NULL || !buffer_uptodate(bh)) {
+		struct blk_plug plug;
+
+		/* Y2: plug like the FAT-table readahead (fatent.c) so a cluster's
+		 * per-sector readahead reaches an SD card as one request, not one
+		 * 512-byte read per sector (POWER-FINAL-30, see exfat). */
+		blk_start_plug(&plug);
 		for (sec = 0; sec < sbi->sec_per_clus; sec++)
 			sb_breadahead(sb, phys + sec);
+		blk_finish_plug(&plug);
 	}
 	brelse(bh);
 }
