-mtp_size send_file_data( mtp_ctx * ctx, fs_entry * entry,mtp_offset offset, mtp_size maxsize )
+/* Pin one complete inode. Check every read/write; never transmit stale cache
+ * bytes after a local truncation, or acknowledge a short USB IN transfer. */
