 	PRINT_DEBUG_BUF(ctx->rdbuffer2, sz);
 
-	new_handle = 0xFFFFFFFF;
+	/* A new upload cancels any abandoned SendObjectInfo reservation. */
+    for (fs_entry *e=ctx->fs_db->entry_list; e; e=e->next) {
+        if (e->y2_upload) { y2_upload_abort(e->y2_upload); e->y2_upload=NULL; e->flags |= ENTRY_IS_DELETED; }
+    }
+    if (sz < (int)(sizeof(MTP_PACKET_HEADER)+0x35) ||
+        sz < (int)(sizeof(MTP_PACKET_HEADER)+0x35+2*ctx->rdbuffer2[sizeof(MTP_PACKET_HEADER)+0x34])) {
+        pthread_mutex_unlock(&ctx->inotify_mutex);
+        return MTP_RESPONSE_INVALID_DATASET;
+    }
+    new_handle = 0xFFFFFFFF;
 
 	response_code = parse_incoming_dataset(ctx,ctx->rdbuffer2,sz,&new_handle,parent_handle,storageid);
 	if( response_code == MTP_RESPONSE_OK )
