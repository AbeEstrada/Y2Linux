+/* Flag publication and the predicate wait share this mutex, so cancellation
+ * cannot land between the check and sleep. Keep the receive/storage pipeline. */
+void y2_rx_set_flag(volatile int *flag, int value)
+{
+    pthread_mutex_lock(&lock);
+    *flag = value;
+    pthread_cond_broadcast(&data);
+    pthread_mutex_unlock(&lock);
+}
+
 static int wait_data(volatile int *cancel, volatile int *stop)
 {
     for (;;) {
         if (count > 0) return 0;
         if (failed || !running || (stop && *stop)) return -1;
         if (cancel && *cancel) return -1;
-        struct timespec until;
-        clock_gettime(CLOCK_REALTIME, &until);
-        until.tv_nsec += 20 * 1000000L;
-        if (until.tv_nsec >= 1000000000L) { until.tv_sec++; until.tv_nsec -= 1000000000L; }
-        pthread_cond_timedwait(&data, &lock, &until);
+        pthread_cond_wait(&data, &lock);
     }
 }
 
