diff --color -ruN -x obj -x umtprd -x 'mtp-safe.*' -x '*.o' mtp-src.orig/inc/y2_rx.h mtp-src/inc/y2_rx.h
--- a/inc/y2_rx.h
+++ b/inc/y2_rx.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef Y2_RX_H
+#define Y2_RX_H
+#include <stddef.h>
+/* Dedicated bulk-OUT reader: a read request is always queued on the endpoint,
+ * so a host packet never arrives while the gadget has nothing to receive it
+ * with, and USB reception overlaps storage writes. */
+int y2_rx_start(int fd, size_t slot_size);
+void y2_rx_stop(void);
+int y2_rx_active(void);
+/* Pop the next USB read (>=0 bytes, 0 is a ZLP). -1: stopped, failed or cancelled. */
+int y2_rx_read(unsigned char *destination, int maximum, volatile int *cancel, volatile int *stop);
+/* Borrow the next read in place; release with y2_rx_done(). NULL: -1 case above. */
+const unsigned char *y2_rx_peek(int *length, volatile int *cancel, volatile int *stop);
+void y2_rx_done(void);
+void y2_rx_flush(void);
+#endif
