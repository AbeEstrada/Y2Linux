diff --color -ruN -x obj -x umtprd -x 'mtp-safe.*' -x '*.o' mtp-src.orig/src/y2_rx.c mtp-src/src/y2_rx.c
--- a/src/y2_rx.c
+++ b/src/y2_rx.c
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <time.h>
+#include <unistd.h>
+#include "y2_rx.h"
+
+/* Bulk-OUT receive on its own thread. USB reception overlaps the slower storage
+ * writes of the consumer: while one request is being written, later requests
+ * are already queued on the endpoint and land in the ring. When the ring is
+ * full the endpoint simply NAKs the host (the controller keeps one received
+ * packet in its FIFO and the kernel hands it to the next queued request). */
+#define SLOTS 32
+static struct slot { unsigned char *buffer; int length; } slots[SLOTS];
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t data = PTHREAD_COND_INITIALIZER, space = PTHREAD_COND_INITIALIZER;
+static pthread_t thread;
+static int running, failed, head, tail, count, descriptor = -1, borrowed;
+static size_t slot_size;
+
+static void *reader(void *unused)
+{
+    (void)unused;
+    prctl(PR_SET_NAME, (unsigned long)"y2_rx");
+    for (;;) {
+        pthread_mutex_lock(&lock);
+        while (running && count == SLOTS) pthread_cond_wait(&space, &lock);
+        if (!running) { pthread_mutex_unlock(&lock); break; }
+        struct slot *slot = &slots[head];
+        pthread_mutex_unlock(&lock);
+        ssize_t n = read(descriptor, slot->buffer, slot_size);
+        pthread_mutex_lock(&lock);
+        if (n < 0) {
+            if (errno == EINTR && running) { pthread_mutex_unlock(&lock); continue; }
+            failed = 1;
+            pthread_cond_broadcast(&data);
+            pthread_mutex_unlock(&lock);
+            break;
+        }
+        slot->length = (int)n;
+        head = (head + 1) % SLOTS;
+        count++;
+        pthread_cond_broadcast(&data);
+        pthread_mutex_unlock(&lock);
+    }
+    return NULL;
+}
+
+int y2_rx_start(int fd, size_t size)
+{
+    if (running) return 0;
+    pthread_mutex_lock(&lock);
+    for (int i = 0; i < SLOTS; i++) {
+        if (slots[i].buffer && size != slot_size) { free(slots[i].buffer); slots[i].buffer = NULL; }
+        if (!slots[i].buffer && !(slots[i].buffer = malloc(size))) { pthread_mutex_unlock(&lock); return -1; }
+        slots[i].length = 0;
+    }
+    slot_size = size; descriptor = fd; head = tail = count = failed = borrowed = 0; running = 1;
+    pthread_mutex_unlock(&lock);
+    if (pthread_create(&thread, NULL, reader, NULL)) { running = 0; return -1; }
+    return 0;
+}
+
+void y2_rx_stop(void)
+{
+    pthread_mutex_lock(&lock);
+    if (!running) { pthread_mutex_unlock(&lock); return; }
+    running = 0;
+    pthread_cond_broadcast(&space);
+    pthread_cond_broadcast(&data);
+    pthread_mutex_unlock(&lock);
+    /* SIGUSR1 has a no-op handler without SA_RESTART: it interrupts a blocked read. */
+    pthread_kill(thread, SIGUSR1);
+    pthread_join(thread, NULL);
+}
+
+int y2_rx_active(void) { return running; }
+
+void y2_rx_flush(void)
+{
+    pthread_mutex_lock(&lock);
+    if (!borrowed) { tail = head; count = 0; pthread_cond_broadcast(&space); }
+    pthread_mutex_unlock(&lock);
+}
+
+static int wait_data(volatile int *cancel, volatile int *stop)
+{
+    for (;;) {
+        if (count > 0) return 0;
+        if (failed || !running || (stop && *stop)) return -1;
+        if (cancel && *cancel) return -1;
+        struct timespec until;
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_nsec += 20 * 1000000L;
+        if (until.tv_nsec >= 1000000000L) { until.tv_sec++; until.tv_nsec -= 1000000000L; }
+        pthread_cond_timedwait(&data, &lock, &until);
+    }
+}
+
+const unsigned char *y2_rx_peek(int *length, volatile int *cancel, volatile int *stop)
+{
+    pthread_mutex_lock(&lock);
+    if (wait_data(cancel, stop)) { pthread_mutex_unlock(&lock); return NULL; }
+    borrowed = 1;
+    *length = slots[tail].length;
+    const unsigned char *buffer = slots[tail].buffer;
+    pthread_mutex_unlock(&lock);
+    return buffer;
+}
+
+void y2_rx_done(void)
+{
+    pthread_mutex_lock(&lock);
+    if (borrowed && count > 0) { tail = (tail + 1) % SLOTS; count--; pthread_cond_signal(&space); }
+    borrowed = 0;
+    pthread_mutex_unlock(&lock);
+}
+
+int y2_rx_read(unsigned char *destination, int maximum, volatile int *cancel, volatile int *stop)
+{
+    int length;
+    const unsigned char *buffer = y2_rx_peek(&length, cancel, stop);
+    if (!buffer) return -1;
+    if (length > maximum) length = maximum;
+    memcpy(destination, buffer, length);
+    y2_rx_done();
+    return length;
+}
