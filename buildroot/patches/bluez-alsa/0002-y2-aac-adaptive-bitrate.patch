+++ b/src/y2-aac-abr.h
@@ -0,0 +1,84 @@
+/*
+ * Y2Linux: adaptive bit rate for CBR AAC, the counterpart of LDAC ABR.
+ *
+ * BlueALSA keeps a three-packet socket buffer and otherwise blocks while the
+ * radio cannot deliver, so a weak link starved the headphones of audio at a
+ * full bit rate. This steps the encoder down while the socket queue backs up
+ * and back up after a quiet stretch. Pure decisions, no I/O: unit-tested.
+ *
+ * This file is free software; you can redistribute it and/or modify it under
+ * the terms of the MIT license. See the COPYING file for details.
+ */
+#ifndef Y2_AAC_ABR_H_
+#define Y2_AAC_ABR_H_
+
+#include <stdbool.h>
+
+#define Y2_AAC_ABR_LEVELS 4
+/* Lowest rate used, comparable to common SBC "high" quality. */
+#define Y2_AAC_ABR_FLOOR 128000u
+/* Never step twice within this many frames (~0.2 s at 44.1 kHz). */
+#define Y2_AAC_ABR_HOLD 8
+/* Frames with an empty socket queue before stepping up (~10 s). */
+#define Y2_AAC_ABR_CALM 430
+/* RTP header plus LATM mux config and payload length bytes. */
+#define Y2_AAC_FRAME_OVERHEAD 28
+
+struct y2_aac_abr {
+	bool enabled;
+	unsigned int level;
+	unsigned int rates[Y2_AAC_ABR_LEVELS];
+	unsigned int calm;
+	unsigned int since_change;
+};
+
+/* Highest CBR rate whose 1024-sample frames fit one packet of `mtu` bytes:
+ * some headsets cannot reassemble fragmented AAC frames. */
+static inline unsigned int y2_aac_mtu_bitrate(unsigned int mtu, unsigned int rate) {
+	if (mtu <= Y2_AAC_FRAME_OVERHEAD || rate == 0)
+		return 0;
+	return (unsigned int)((unsigned long long)(mtu - Y2_AAC_FRAME_OVERHEAD) * 8 * rate / 1024);
+}
+
+static inline void y2_aac_abr_init(struct y2_aac_abr *abr, unsigned int bitrate, bool enabled) {
+	static const unsigned int eighths[Y2_AAC_ABR_LEVELS] = { 8, 6, 5, 4 };
+	abr->level = abr->calm = abr->since_change = 0;
+	for (unsigned int i = 0; i < Y2_AAC_ABR_LEVELS; i++) {
+		unsigned int value = (unsigned int)((unsigned long long)bitrate * eighths[i] / 8);
+		if (value < Y2_AAC_ABR_FLOOR)
+			value = bitrate < Y2_AAC_ABR_FLOOR ? bitrate : Y2_AAC_ABR_FLOOR;
+		abr->rates[i] = value;
+	}
+	/* Nothing to adapt when every level is the same rate. */
+	abr->enabled = enabled && abr->rates[Y2_AAC_ABR_LEVELS - 1] < abr->rates[0];
+}
+
+/* Call once per encoded frame with the socket queue depth (in packets) seen
+ * before writing it and whether the write had to wait. Returns the new bit
+ * rate when the level changes, otherwise 0. */
+static inline unsigned int y2_aac_abr_update(struct y2_aac_abr *abr,
+		unsigned int queued_packets, bool blocked) {
+	if (!abr->enabled)
+		return 0;
+	if (abr->since_change < Y2_AAC_ABR_HOLD)
+		abr->since_change++;
+	if (blocked || queued_packets >= 2) {
+		abr->calm = 0;
+		if (abr->level + 1 < Y2_AAC_ABR_LEVELS && abr->since_change >= Y2_AAC_ABR_HOLD) {
+			abr->level++;
+			abr->since_change = 0;
+			return abr->rates[abr->level];
+		}
+		return 0;
+	}
+	abr->calm = queued_packets == 0 ? abr->calm + 1 : 0;
+	if (abr->level > 0 && abr->calm >= Y2_AAC_ABR_CALM) {
+		abr->level--;
+		abr->calm = 0;
+		abr->since_change = 0;
+		return abr->rates[abr->level];
+	}
+	return 0;
+}
+
+#endif
