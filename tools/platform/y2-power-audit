#!/usr/bin/env python3
"""Endpoint-only observation: no activity during the measured sleep window."""
import argparse
import glob
import json
import os
import resource
import sys
import time
from pathlib import Path


def read(path):
    try:
        return Path(path).read_text().strip()
    except (OSError, UnicodeError):
        return None


def files(patterns):
    return {p: read(p) for pattern in patterns for p in sorted(glob.glob(pattern))
            if Path(p).is_file()}


def processes():
    result = {}
    for path in glob.glob('/proc/[0-9]*/task/[0-9]*/stat'):
        raw = read(path)
        if raw is None:
            continue
        start, _, rest = raw.partition('(')
        name, _, tail = rest.rpartition(')')
        parts = tail.split()
        if len(parts) < 20:
            continue
        status = read(str(Path(path).with_name('status'))) or ''
        switches = {line.split(':')[0]: int(line.split(':')[1])
                    for line in status.splitlines() if 'ctxt_switches:' in line}
        result[':'.join((path.split('/')[2], path.split('/')[4], parts[19]))] = {
            'name': name, 'state': parts[0], 'utime': int(parts[11]),
            'stime': int(parts[12]), 'context_switches': switches,
            'wchan': read(str(Path(path).with_name('wchan')))}
    return result


def application():
    # Outside the counter window; publish no media names, paths or peer IDs.
    sys.path.insert(0, '/usr/lib/y2-platform')
    try:
        from y2_platform.common import Context
        from y2_platform.suspend_record import application_rpc
        status = application_rpc(Context(), 'status')
        return {'screen_off': status.get('screen_off'),
                'playback_state': status.get('playback', {}).get('state'),
                'scanning': status.get('library', {}).get('scanning'),
                'audio_state': status.get('audio', {}).get('state'),
                'graphics': {key: status.get('graphics', {}).get(key)
                             for key in ('backend', 'frames', 'context_losses')}}
    except (ImportError, OSError, ValueError, TypeError, AttributeError) as error:
        return {'unavailable': type(error).__name__}


def snapshot():
    start = time.monotonic()
    result = {
        'wall_time': time.time(), 'monotonic': start,
        'boot_id': read('/proc/sys/kernel/random/boot_id'),
        'identity': read('/etc/y2linux/versions.json'),
        'kernel': os.uname().release,
        'application': application(),
        'files': files([
            '/proc/stat', '/proc/interrupts', '/proc/softirqs', '/proc/uptime',
            '/proc/diskstats', '/proc/timer_list', '/proc/modules', '/proc/version',
            '/etc/os-release', '/sys/module/pwrap/parameters/*',
            '/sys/devices/system/cpu/online',
            '/sys/devices/system/cpu/cpu*/cpuidle/state*/*',
            '/sys/devices/system/cpu/cpufreq/policy0/scaling_*',
            '/sys/devices/system/cpu/cpufreq/policy0/stats/*',
            '/sys/module/idle/parameters/*', '/sys/module/clocks/parameters/*blockers',
            '/sys/module/spm/parameters/*',
            '/sys/bus/platform/devices/10006000*/state',
            '/sys/bus/platform/devices/10006000*/dormant_preflight',
            '/sys/bus/platform/devices/*/power/runtime_status',
            '/sys/bus/platform/devices/*/power/runtime_suspended_time',
            '/sys/bus/platform/devices/*/power/runtime_active_time',
            '/sys/bus/platform/devices/*/power/control',
            '/sys/bus/i2c/devices/*/power/runtime_status',
            '/sys/bus/platform/devices/11200000.usb/status',
            '/sys/bus/platform/devices/11200000.usb/rxdiag',
            '/sys/class/power_supply/*/uevent',
            '/sys/class/power_supply/BAT0/charging_state',
            '/sys/class/backlight/*/brightness', '/sys/class/backlight/*/bl_power',
            '/sys/class/rfkill/*/type', '/sys/class/rfkill/*/soft',
            '/sys/class/net/*/operstate', '/sys/class/net/*/statistics/*',
            '/proc/asound/card*/pcm*/sub*/status',
            '/sys/kernel/debug/clk/clk_summary', '/sys/kernel/debug/wakeup_sources',
            '/sys/kernel/debug/suspend_stats', '/sys/kernel/debug/dri/*/state',
            '/sys/class/udc/*/state', '/sys/class/udc/*/current_speed',
            '/run/y2/power.json', '/run/y2/cpu-idle-policy.json',
            '/run/y2/wifi-power.json', '/run/y2/bt-reconnect.json',
            '/run/y2/coexistence.json', '/run/y2/usb-transfer.json',
            '/run/y2/sleep.json', '/run/y2/codec-runtime.json']),
        'threads': processes(),
    }
    result['collection_seconds'] = time.monotonic() - start
    return result


def counters():
    start = time.monotonic()
    cpu_start = time.process_time()
    result = {'boot_id': read('/proc/sys/kernel/random/boot_id'), 'threads': processes()}
    result['files'] = files([
        '/proc/stat', '/proc/interrupts', '/proc/softirqs', '/proc/diskstats',
        '/sys/devices/system/cpu/cpufreq/policy0/stats/time_in_state',
        '/sys/devices/system/cpu/cpu*/cpuidle/state*/usage',
        '/sys/devices/system/cpu/cpu*/cpuidle/state*/time',
        '/sys/devices/system/cpu/cpu*/cpuidle/state*/name',
        '/sys/module/idle/parameters/*', '/sys/module/clocks/parameters/*blockers',
        '/sys/bus/platform/devices/10006000*/state',
        '/sys/kernel/debug/wakeup_sources', '/sys/devices/system/cpu/online',
        '/sys/class/power_supply/BAT0/voltage_now', '/run/y2/power.json'])
    result['monotonic'] = time.monotonic()
    result['collection_seconds'] = result['monotonic'] - start
    result['cpu_seconds'] = time.process_time() - cpu_start
    return result


def delta(a, b, duration):
    if duration <= 0 or a['boot_id'] != b['boot_id']:
        raise ValueError('counter_window_crosses_boot_or_has_no_duration')
    offenders = []
    for key, old in a['threads'].items():
        new = b['threads'].get(key)
        if new is None:
            continue
        ticks = new['utime'] + new['stime'] - old['utime'] - old['stime']
        ctx = sum(new['context_switches'].values()) - sum(old['context_switches'].values())
        offenders.append({'thread': key, 'name': new['name'], 'ticks': ticks,
                          'cpu_percent_one_core': 100*ticks/os.sysconf('SC_CLK_TCK')/duration,
                          'context_switches_per_second': ctx/duration})
    irq = []
    def interrupts(sample):
        rows = {}
        lines = (sample['files'].get('/proc/interrupts') or '').splitlines()
        cpus = lines[0].split() if lines else []
        for line in lines[1:]:
            if ':' not in line:
                continue
            key, tail = line.split(':', 1)
            parts = tail.split()
            counts = []
            while parts and parts[0].isdigit():
                counts.append(int(parts.pop(0)))
            rows[key.strip()] = (dict(zip(cpus, counts)) if len(counts) == len(cpus) else {},
                                 ' '.join(parts))
        return rows
    ia, ib = interrupts(a), interrupts(b)
    for key, (counts, name) in ib.items():
        old = ia.get(key, ({}, ''))[0]
        common = {cpu: counts[cpu] - old[cpu] for cpu in old.keys() & counts.keys()}
        columns_changed = old.keys() != counts.keys()
        reset = any(value < 0 for value in common.values())
        valid = bool(common) and not columns_changed and not reset
        d = sum(common.values()) if valid else None
        # Offline CPU columns disappear, even though their earlier IRQ totals
        # remain relevant. Subtracting column sums can silently undercount even
        # when the apparent delta is positive. Keep common-CPU evidence separate.
        lower_bound = sum(common.values()) if common and not reset else None
        irq.append({'irq': key, 'name': name, 'delta': d,
                    'per_second': d/duration if d is not None else None,
                    'counter_discontinuity': not valid,
                    'cpu_columns_changed': columns_changed,
                    'common_cpu_deltas': common,
                    'common_cpu_lower_bound_per_second': lower_bound/duration if lower_bound is not None else None})
    idle = []
    for path, val in a['files'].items():
        if '/cpuidle/' in path and path.endswith('/time'):
            end = b['files'].get(path)
            if val is None or end is None:
                continue
            parent = path.rsplit('/', 1)[0]
            usage = parent + '/usage'
            time_us = int(end) - int(val)
            entries = int(b['files'][usage]) - int(a['files'][usage])
            discontinuity = time_us < 0 or entries < 0
            idle.append({'path': parent, 'name': a['files'].get(parent+'/name'),
                         'raw_time_delta_us': time_us,
                         'time_us': None if discontinuity else time_us,
                         'percent_wall_time': None if discontinuity else time_us/duration/10000,
                         'entries': None if discontinuity else entries,
                         'counter_discontinuity': discontinuity})
    # An idle interval is charged when that CPU exits it. An untouched secondary
    # CPU can therefore charge time that began before the first endpoint read.
    # Reject impossible per-CPU totals instead of publishing/clamping >100%.
    by_cpu = {}
    for row in idle:
        by_cpu.setdefault(row['path'].split('/cpuidle/')[0], []).append(row)
    for rows in by_cpu.values():
        if all(row['time_us'] is not None for row in rows) and sum(row['time_us'] for row in rows) > duration * 1e6:
            for row in rows:
                row.update(time_us=None, percent_wall_time=None,
                           residency_invalid_reason='idle_accounting_crosses_counter_window')
    frequency = []
    path = '/sys/devices/system/cpu/cpufreq/policy0/stats/time_in_state'
    def opps(sample):
        return {int(k): int(v) for k, v in
                (line.split() for line in (sample['files'].get(path) or '').splitlines())}
    fa, fb = opps(a), opps(b)
    fd = {key: val-fa[key] for key, val in fb.items() if key in fa and val >= fa[key]}
    total = sum(fd.values())
    frequency = [{'khz': key, 'ticks': val, 'percent_recorded_residency': 100*val/total if total else None}
                 for key, val in sorted(fd.items())]
    def proc_stat(sample):
        return {parts[0]: int(parts[1]) for line in (sample['files'].get('/proc/stat') or '').splitlines()
                if (parts := line.split()) and parts[0] in {'ctxt', 'processes', 'intr'}}
    sa, sb = proc_stat(a), proc_stat(b)
    scheduler = {key: {'delta': sb[key]-sa[key], 'per_second': (sb[key]-sa[key])/duration}
                 for key in sa.keys() & sb.keys() if sb[key] >= sa[key]}
    wakes = []
    def wake_sources(sample):
        rows = (sample['files'].get('/sys/kernel/debug/wakeup_sources') or '').splitlines()
        if not rows:
            return {}
        header = rows[0].split()
        return {parts[0]: dict(zip(header[1:], parts[1:])) for row in rows[1:] if (parts := row.split())}
    wa, wb = wake_sources(a), wake_sources(b)
    for name in wa.keys() & wb.keys():
        changes = {key: int(wb[name][key])-int(wa[name][key]) for key in ('event_count', 'wakeup_count', 'active_count')
                   if key in wa[name] and key in wb[name]}
        wakes.append({'name': name, 'deltas': changes})
    cpu0_rows = [row for row in idle if '/cpu0/' in row['path']]
    cpu0_exits = (sum(row['entries'] for row in cpu0_rows)
                 if cpu0_rows and all(row['entries'] is not None for row in cpu0_rows) else None)
    return {'top_cpu_threads': sorted(offenders, key=lambda x:x['ticks'], reverse=True)[:25],
            'top_context_switch_threads': sorted(offenders, key=lambda x:x['context_switches_per_second'], reverse=True)[:25],
            'irqs': sorted(irq, key=lambda x:x['delta'] or 0, reverse=True), 'cpuidle': idle,
            'cpu0_idle_exits_per_second': cpu0_exits/duration if cpu0_exits is not None else None,
            'frequency_residency': frequency,
            'frequency_reason': None if frequency else 'Kernel does not expose OPP residency counters.',
            'scheduler': scheduler, 'wakeup_sources': wakes,
            'wakeups_per_second': None,
            'wakeups_reason': 'Context switches and IRQs are proxies; they are not independent unique CPU wakes.'}


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--seconds', type=float, default=60)
    p.add_argument('--settle', type=float, default=10)
    p.add_argument('--state', required=True)
    p.add_argument('--output', required=True)
    args = p.parse_args()
    if not 1 <= args.seconds <= 7200 or not 0 <= args.settle <= 120:
        p.error('bounded windows only')
    cpu_start = time.process_time()
    state_start = snapshot()
    time.sleep(args.settle)
    a = counters()
    measured_start = time.monotonic()
    time.sleep(args.seconds)
    measured_end = time.monotonic()
    b = counters()
    # Heavy device/clock/process descriptions run outside the counter interval.
    state_end = snapshot()
    duration = b['monotonic'] - a['monotonic']
    result = {'schema': 'org.y2linux.power-audit/v2', 'state': args.state,
              'duration_seconds': duration, 'undisturbed_sleep_seconds': measured_end-measured_start,
              'same_boot': a['boot_id']==b['boot_id'], 'start': a, 'end': b,
              'state_start': state_start, 'state_end': state_end,
              'summary': delta(a,b,duration),
              'observer': {'pid': os.getpid(), 'total_cpu_seconds': time.process_time()-cpu_start,
                           'counter_cpu_seconds': a['cpu_seconds']+b['cpu_seconds'],
                           'counter_collection_seconds': a['collection_seconds']+b['collection_seconds'],
                           'max_rss_kib': resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
                           'note': 'Endpoint counter skew is bounded by collection time; descriptions are outside the window.'}}
    out = Path(args.output)
    fd = os.open(out, os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as stream:
        json.dump(result, stream, separators=(',', ':'))
        stream.write('\n')



if __name__ == '__main__':
    main()
