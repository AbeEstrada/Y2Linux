 "stock_suspend_hooks": {
  "tpd_suspend": {
   "addr": "0xc04a41c0",
   "behaviour": "read APT32F reg6 (firmware); 1..19: write reg5=1 (sleep); else GPIO56 low (reset held)"
  },
  "tpd_resume": {
   "addr": "0xc04a3088",
   "behaviour": "GPIO56 high, 10 ms, low, 20 ms, high; write reg5=0"
  },
  "usb_phy_savecurrent_internal": {
   "addr": "0xc04d98f0",
   "behaviour": "PHY 0x11210800: force suspendm with pulldowns/xcvrsel/termsel, BC1.1 and VBUS comparator off, then USB clock off"
  },
  "pmic_mt6323_suspend": {
   "addr": "0xc04b3dd4",
   "behaviour": "VREF18_ENB=1, ADC_DECI_GDLY=1, CLKSQ_EN_AUX=1, AUD26M_DIV4_CK_PDN=0, AUXADC SDM HW mode, SDM clocks on"
  },
  "cs43131_early_suspend": {
   "addr": "0xc054bed0",
   "behaviour": "if no audio: GPIO15/18/20 low and hwPowerDown(id 6, VGP2 refcount)"
  },
  "lcm_suspend (GC9503)": {
   "addr": "0xc04a24f4",
   "behaviour": "39-row table: power regs, display off 0x28, sleep in 0x10, AF=02 tail; reset pin left high"
  },
  "slp_suspend_ops_enter": {
   "addr": "0xc0035bd4",
   "behaviour": "spm_go_to_sleep only (no clock writes); golden/register dumps"
  }
 },
 "apt32f_firmware_read": {
  "reg6": "0x01",
  "method": "i2ctransfer -f -y 0 w1@0x51 6 r1 (read-only, 2026-10-11, POWER-FINAL-12)"
 }
}